<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.cortis.desktop.controller.MainMenuController"
           stylesheets="@../css/main-menu.css"
           styleClass="main-root">

    <Region styleClass="dark-overlay"/>

    <VBox maxWidth="420"
          spacing="28"
          styleClass="menu-card">

        <padding>
            <Insets top="42" right="42" bottom="42" left="42"/>
        </padding>

        <Label text="CORTIS" styleClass="main-title"/>
        <Label text="Főmenü" styleClass="subtitle"/>

        <VBox spacing="18">

            <Button fx:id="warehouseButton"
                    text="Raktár"
                    onAction="#openWarehouse"
                    maxWidth="Infinity"
                    prefHeight="54"
                    styleClass="main-menu-button"/>

            <Button fx:id="ordersButton"
                    text="Megrendelés"
                    maxWidth="Infinity"
                    prefHeight="54"
                    styleClass="main-menu-button"/>

            <Button fx:id="calculationButton"
                    text="Kalkuláció"
                    maxWidth="Infinity"
                    prefHeight="54"
                    styleClass="main-menu-button"/>

        </VBox>

        <HBox spacing="12">
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="logoutButton"
                    text="Kijelentkezés"
                    onAction="#handleLogout"
                    prefWidth="130"
                    prefHeight="34"
                    styleClass="secondary-button"/>
        </HBox>

    </VBox>

</StackPane>