<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.cortis.desktop.controller.LoginController"
           fx:id="rootPane"
           styleClass="login-root"
           alignment="CENTER_RIGHT"
           stylesheets="@../css/login.css">

    <!-- Bejelentkezési panel -->
    <VBox fx:id="loginCard"
          alignment="CENTER"
          spacing="16"
          minWidth="320"
          prefWidth="380"
          maxWidth="440"
          styleClass="login-card"
          StackPane.alignment="CENTER_RIGHT">

        <!-- Külső távolság az ablak jobb szélétől -->
        <StackPane.margin>
            <Insets right="40"/>
        </StackPane.margin>

        <!-- A panel belső térköze -->
        <padding>
            <Insets top="42"
                    right="42"
                    bottom="42"
                    left="42"/>
        </padding>

        <!-- Cím -->
        <Label fx:id="loginTitleLabel"
               text="Bejelentkezés"
               maxWidth="Infinity"
               styleClass="login-title"/>

        <!-- Alcím -->
        <Label fx:id="loginSubtitleLabel"
               text="Lépj be a CORTIS rendszerbe"
               maxWidth="Infinity"
               wrapText="true"
               styleClass="login-subtitle"/>

        <!-- Felhasználónév -->
        <Label fx:id="usernameLabel"
               text="Felhasználónév"
               maxWidth="Infinity"
               styleClass="field-label"/>

        <TextField fx:id="usernameField"
                   promptText="Add meg a felhasználóneved"
                   maxWidth="Infinity"
                   prefHeight="44"
                   styleClass="input-field"/>

        <!-- Jelszó -->
        <Label fx:id="passwordLabel"
               text="Jelszó"
               maxWidth="Infinity"
               styleClass="field-label"/>

        <!--
            A PasswordField, a látható TextField és a szem ikon
            egymáson helyezkednek el.
        -->
        <StackPane maxWidth="Infinity"
                   prefHeight="44"
                   minHeight="44"
                   maxHeight="44">

            <PasswordField fx:id="passwordField"
                           promptText="Add meg a jelszavad"
                           maxWidth="Infinity"
                           prefHeight="44"
                           styleClass="password-input"/>

            <TextField fx:id="visiblePasswordField"
                       promptText="Add meg a jelszavad"
                       maxWidth="Infinity"
                       prefHeight="44"
                       visible="false"
                       styleClass="password-input"/>

            <!--
                A jelszó addig látható,
                amíg az egérgombot lenyomva tartod.
            -->
            <Button fx:id="showPasswordButton"
                    text="👁"
                    focusTraversable="false"
                    mnemonicParsing="false"
                    StackPane.alignment="CENTER_RIGHT"
                    onMousePressed="#showPassword"
                    onMouseReleased="#hidePassword"
                    onMouseExited="#hidePassword"
                    styleClass="password-eye-button">

                <StackPane.margin>
                    <Insets right="8"/>
                </StackPane.margin>

            </Button>

        </StackPane>

        <!-- Hibaüzenet -->
        <Label fx:id="errorLabel"
               text=""
               minHeight="20"
               maxWidth="Infinity"
               wrapText="true"
               styleClass="message-label"/>

        <!-- Bejelentkezés gomb -->
        <Button fx:id="loginButton"
                text="Bejelentkezés"
                onAction="#handleLogin"
                defaultButton="true"
                maxWidth="Infinity"
                prefHeight="44"
                styleClass="login-button"/>

    </VBox>

    <!-- Nyelvválasztó -->
    <MenuButton fx:id="languageMenuButton"
                text="🌐 HU"
                mnemonicParsing="false"
                focusTraversable="false"
                styleClass="language-menu"
                StackPane.alignment="BOTTOM_RIGHT">

        <StackPane.margin>
            <Insets right="20"
                    bottom="20"/>
        </StackPane.margin>

        <items>
            <MenuItem id="hu"
                      text="Magyar"
                      onAction="#handleLanguageChange"/>

            <MenuItem id="de"
                      text="Deutsch"
                      onAction="#handleLanguageChange"/>

            <MenuItem id="en"
                      text="English"
                      onAction="#handleLanguageChange"/>
        </items>

    </MenuButton>

</StackPane>