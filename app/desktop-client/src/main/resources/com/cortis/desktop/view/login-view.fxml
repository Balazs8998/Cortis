<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.cortis.desktop.auth.controller.LoginController"
           fx:id="rootPane"
           styleClass="login-root"
           alignment="CENTER_RIGHT"
           stylesheets="@../css/login.css">

    <!-- Teljes bejelentkezési kártya -->
    <VBox fx:id="loginCard"
          alignment="CENTER"
          spacing="16"
          minWidth="320"
          prefWidth="380"
          maxWidth="440"
          styleClass="login-card"
          StackPane.alignment="CENTER_RIGHT">

        <StackPane.margin>
            <Insets right="40"/>
        </StackPane.margin>

        <padding>
            <Insets top="42"
                    right="42"
                    bottom="42"
                    left="42"/>
        </padding>

        <!-- Közös cím -->
        <Label fx:id="loginTitleLabel"
               text="Bejelentkezés"
               maxWidth="Infinity"
               styleClass="login-title"/>

        <!-- Közös alcím -->
        <Label fx:id="loginSubtitleLabel"
               text="Lépj be a CORTIS rendszerbe"
               maxWidth="Infinity"
               wrapText="true"
               styleClass="login-subtitle"/>

        <!-- Felhasználónév és jelszó alapú belépés -->
        <VBox fx:id="passwordLoginBox"
              alignment="CENTER"
              spacing="16"
              maxWidth="Infinity">

            <Label fx:id="usernameLabel"
                   text="Felhasználónév"
                   maxWidth="Infinity"
                   styleClass="field-label"/>

            <TextField fx:id="usernameField"
                       promptText="Add meg a felhasználóneved"
                       maxWidth="Infinity"
                       prefHeight="44"
                       styleClass="input-field"/>

            <Label fx:id="passwordLabel"
                   text="Jelszó"
                   maxWidth="Infinity"
                   styleClass="field-label"/>

            <!-- Jelszómező, látható jelszómező és szemgomb -->
            <StackPane maxWidth="Infinity"
                       prefHeight="44"
                       minHeight="44"
                       maxHeight="44">

                <PasswordField fx:id="passwordField"
                               promptText="Add meg a jelszavad"
                               maxWidth="Infinity"
                               prefHeight="44"
                               styleClass="password-input"/>

                <TextField fx:id="visiblePasswordField"
                           promptText="Add meg a jelszavad"
                           maxWidth="Infinity"
                           prefHeight="44"
                           visible="false"
                           managed="false"
                           styleClass="password-input"/>

                <Button fx:id="showPasswordButton"
                        text="👁"
                        focusTraversable="false"
                        mnemonicParsing="false"
                        StackPane.alignment="CENTER_RIGHT"
                        onMousePressed="#showPassword"
                        onMouseReleased="#hidePassword"
                        onMouseExited="#hidePassword"
                        styleClass="password-eye-button">

                    <StackPane.margin>
                        <Insets right="8"/>
                    </StackPane.margin>

                </Button>

            </StackPane>

            <!-- Normál bejelentkezés -->
            <Button fx:id="loginButton"
                    text="Bejelentkezés"
                    onAction="#handleLogin"
                    defaultButton="true"
                    maxWidth="Infinity"
                    prefHeight="44"
                    styleClass="login-button"/>

            <!-- Átváltás chipkártyás módra -->
            <Button fx:id="showChipLoginButton"
                    text="Belépés chipkártyával"
                    onAction="#handleShowChipLogin"
                    mnemonicParsing="false"
                    maxWidth="Infinity"
                    prefHeight="44"
                    styleClass="login-button"/>

        </VBox>

        <!-- Chipkártyás belépés -->
        <VBox fx:id="chipLoginBox"
              alignment="CENTER"
              spacing="16"
              maxWidth="Infinity"
              visible="false"
              managed="false">

            <Label fx:id="chipLoginTitleLabel"
                   text="Chipkártyás bejelentkezés"
                   maxWidth="Infinity"
                   wrapText="true"
                   styleClass="field-label"/>

            <Label fx:id="chipLoginInstructionLabel"
                   text="Húzza le vagy érintse az olvasóhoz a chipkártyát."
                   maxWidth="Infinity"
                   wrapText="true"
                   styleClass="login-subtitle"/>

            <!--
                Az olvasó ide írja be a chipkódot.
                Nem lehet visible=false, mert akkor nem tud fókuszt kapni.
            -->
            <TextField fx:id="chipCodeField"
                       promptText=""
                       maxWidth="Infinity"
                       prefHeight="1"
                       minHeight="1"
                       maxHeight="1"
                       opacity="0.0"
                       onAction="#handleChipCardLogin"
                       styleClass="chip-reader-field"/>

            <!-- Vissza a felhasználónév/jelszó belépéshez -->
            <Button fx:id="showPasswordLoginButton"
                    text="Vissza a normál bejelentkezéshez"
                    onAction="#handleShowPasswordLogin"
                    mnemonicParsing="false"
                    maxWidth="Infinity"
                    prefHeight="44"
                    styleClass="login-button"/>

        </VBox>

        <!-- Mindkét loginmód közös hibaüzenete -->
        <Label fx:id="errorLabel"
               text=""
               minHeight="20"
               maxWidth="Infinity"
               wrapText="true"
               styleClass="message-label"/>

    </VBox>

    <!-- Nyelvválasztó -->
    <MenuButton fx:id="languageMenuButton"
                text="🌐 HU"
                mnemonicParsing="false"
                focusTraversable="false"
                styleClass="language-menu"
                StackPane.alignment="BOTTOM_RIGHT">

        <StackPane.margin>
            <Insets right="50"
                    bottom="20"/>
        </StackPane.margin>

        <items>
            <MenuItem id="hu"
                      text="Magyar"
                      onAction="#handleLanguageChange"/>

            <MenuItem id="de"
                      text="Deutsch"
                      onAction="#handleLanguageChange"/>

            <MenuItem id="en"
                      text="English"
                      onAction="#handleLanguageChange"/>
        </items>

    </MenuButton>

</StackPane>